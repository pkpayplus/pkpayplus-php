{
  "name": "pkpayplus/pkpayplus-php",
  "description": "PkPayPlus PHP SDK (merchant API client)",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "PkPayPlus\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PkPayPlus\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  }
}
